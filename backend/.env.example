NODE_ENV=development

PORT=3000

API_PREFIX=api/v1
METRICS_ENABLED=true
LOG_LEVEL=info

CORS_ORIGIN=http://localhost:3000,http://localhost:5173

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

OUTBOUND_TIMEOUT_MS=10000
OUTBOUND_RETRIES=2

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1/places:searchText
SOURCE_PROVIDER_TIMEOUT_MS=10000
SOURCE_PROVIDER_CONCURRENCY=2
SOURCE_PROVIDER_MAX_PAGES=3
SOURCE_PROVIDER=osm
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search
OVERPASS_TIMEOUT_MS=30000
OVERPASS_MAX_RESULTS=100
SOURCE_PROVIDER_RETAIN_RAW_DATA=true
SOURCE_PROVIDER_RETRIES=2
SOURCE_PROVIDER_RETRY_DELAY_MS=250
DISCOVERY_MAX_RESULTS=60
DISCOVERY_PAGE_SIZE=20

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadpilot

REDIS_URL=redis://localhost:6379

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_RETRIES=2

CONTACT_PROVIDER_API_KEY=
EMAIL_ENRICHMENT_API_KEY=
DECISION_MAKER_ROLE_PRIORITIES=CEO,FOUNDER,CO_FOUNDER,PRESIDENT,OWNER,MANAGING_PARTNER,PARTNER,PRINCIPAL,MANAGING_DIRECTOR,DIRECTOR,GENERAL_MANAGER,MANAGER
VERIFICATION_SOURCE_PRIORITIES_JSON={}
VERIFICATION_REVERIFY_AFTER_DAYS=30

WEBSITE_FETCH_TIMEOUT_MS=10000
WEBSITE_MAX_RESPONSE_BYTES=5000000
WEBSITE_FETCH_CONCURRENCY=2
WEBSITE_MAX_PAGES_PER_COMPANY=5
WEBSITE_MAX_CRAWL_DEPTH=1
WEBSITE_MAX_REDIRECTS=5
WEBSITE_FETCH_RETRIES=2
WEBSITE_RESPECT_ROBOTS=true

WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
WEB_SEARCH_TIMEOUT_MS=10000
WEB_SEARCH_MAX_RESULTS=5

DEEP_RESEARCH_MAX_PAGES=8
DEEP_RESEARCH_MAX_DEPTH=1
DEEP_RESEARCH_TIMEOUT_MS=120000
DEEP_RESEARCH_REQUEST_TIMEOUT_MS=10000
DEEP_RESEARCH_CONCURRENCY=2
DEEP_RESEARCH_MAX_RETRIES=2
DEEP_RESEARCH_MAX_CONTENT_CHARS=8000

EXPORT_STORAGE_PATH=./storage/exports
EXPORT_RETENTION_DAYS=7

RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=100
RATE_LIMIT_MAX_REQUESTS_PER_HOUR=1000
RATE_LIMIT_MAX_REQUESTS_PER_DAY=5000
AI_REQUESTS_PER_MINUTE=20
AI_REQUESTS_PER_DAY=500
DEFAULT_DAILY_SEARCH_LIMIT=100
DEFAULT_DAILY_EXPORT_LIMIT=25
DEFAULT_DAILY_AI_LIMIT=500
DEFAULT_MAX_LEADS_PER_SEARCH=1000
DEFAULT_MAX_EXPORT_ROWS=10000
RATE_LIMIT_WINDOW_SECONDS=60
USAGE_PROVIDER_PRICING_JSON={}